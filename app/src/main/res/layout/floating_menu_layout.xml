<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/menu_padding_horizontal"
    android:paddingTop="@dimen/menu_padding_top"
    android:paddingBottom="@dimen/menu_padding_bottom"
    android:background="@drawable/inset_border_drawable"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linear_layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/refresh_text"
            style="@style/MenuTitleStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/refresh_mode" />

        <TextView
            android:id="@+id/scroll_speed_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:text="@string/scroll_speed_off" />

        <ImageView
            android:id="@+id/colors_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:contentDescription="@string/colors"
            android:src="@drawable/baseline_tune_24" />

        <ImageView
            android:id="@+id/settings_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:src="@drawable/baseline_settings_24" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linear_layout"
        style="@style/MenuSegmentedBlockStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/button1"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/clear" />

        <Button
            android:id="@+id/button2"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/balanced" />

        <Button
            android:id="@+id/button3"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/smooth" />

        <Button
            android:id="@+id/button4"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/speed" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/static_aod_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/MenuTitleStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/static_aod_opacity" />

        <TextView
            android:id="@+id/enable_reader_mode_text"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:text="@string/reader_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/static_aod_linear_layout"
        style="@style/MenuSegmentedBlockStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/button_opaque"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/opaque" />

        <Button
            android:id="@+id/button_semi_opaque"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/semiopaque" />

        <Button
            android:id="@+id/button_semi_transparent"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/semiclear" />

        <Button
            android:id="@+id/button_transparent"
            style="@style/SegmentButtonStyle.Fitted"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_control_height"
            android:layout_weight="1"
            android:text="@string/clear" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/light_seekbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_brightness_high_24_dark" />

        <SeekBar
            android:id="@+id/light_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:progressDrawable="@drawable/menu_seekbar_track"
            android:thumbTint="@color/black" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/baseline_moon_24" />

        <Button
            android:id="@+id/button_night"
            style="@style/SegmentButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/menu_control_height"
            android:background="@drawable/segmented_frame"
            android:paddingHorizontal="16dp"
            android:text="Manual" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colors_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/menu_group_gap"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/colors_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/MenuTitleStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/colors" />

            <TextView
                android:id="@+id/colors_reset"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:text="@string/reset" />

            <TextView
                android:id="@+id/recolor_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:text="ON" />
        </LinearLayout>

        <include
            android:id="@+id/line_threshold"
            layout="@layout/color_slider_row" />

        <include
            android:id="@+id/panel_contrast"
            layout="@layout/color_slider_row" />

        <include
            android:id="@+id/panel_black"
            layout="@layout/color_slider_row" />

        <include
            android:id="@+id/panel_white"
            layout="@layout/color_slider_row" />
    </LinearLayout>

</LinearLayout>
